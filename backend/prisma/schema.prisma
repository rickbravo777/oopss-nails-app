generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum ServicePriceType {
  fixed
  starting_at
  range
}

enum AppointmentStatus {
  pending_confirmation
  confirmed
  cancelled
  completed
  no_show
}

enum AppointmentSource {
  chat
  admin
}

enum ScheduleExceptionType {
  day_off
  custom_hours
}

enum ConversationStatus {
  active
  handed_off
  closed
}

enum MessageRole {
  user
  assistant
  system
  human_agent
}

enum PhotoPurpose {
  nail_reference
  hair_desde_evaluation
}

enum EscalationReason {
  facial_recommendation
  laser_zone_confirmation
  hair_desde_pricing
  ai_uncertain
  client_requested_human
}

enum EscalationStatus {
  open
  resolved
}

// ── Core entities ────────────────────────────────────────────────────────

model Client {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())

  appointments  Appointment[]
  conversations Conversation[]
  photoUploads  PhotoUpload[]
}

model Specialist {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  active   Boolean @default(true)
  photoUrl String?
  bio      String?

  createdAt DateTime @default(now())

  services            SpecialistService[]
  scheduleRules       ScheduleRule[]
  scheduleConstraints ScheduleConstraint[]
  scheduleExceptions  ScheduleException[]
  appointments        Appointment[]
  escalationFlags     EscalationFlag[]
}

model ServiceCategory {
  id           String @id @default(uuid()) @db.Uuid
  name         String @unique
  displayOrder Int    @default(0)

  services            Service[]
  scheduleConstraints ScheduleConstraint[]
  termSynonyms        TermSynonym[]
}

model Service {
  id          String           @id @default(uuid()) @db.Uuid
  categoryId  String           @db.Uuid
  category    ServiceCategory  @relation(fields: [categoryId], references: [id])
  name        String           @unique
  description String?
  priceType   ServicePriceType @default(fixed)
  price       Decimal          @db.Decimal(10, 2)
  priceMax    Decimal?         @db.Decimal(10, 2)
  currency    String           @default("USD")

  requiresConsultation   Boolean @default(false)
  requiresPhoto          Boolean @default(false)
  defaultDurationMinutes Int
  sessionPackageSize     Int?

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  specialists         SpecialistService[]
  appointmentLines    AppointmentService[]
  termSynonyms        TermSynonym[]
  scheduleConstraints ScheduleConstraint[]

  @@index([categoryId])
}

model SpecialistService {
  specialistId            String @db.Uuid
  serviceId               String @db.Uuid
  durationOverrideMinutes Int?

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([specialistId, serviceId])
  @@index([serviceId])
}

model ScheduleRule {
  id           String  @id @default(uuid()) @db.Uuid
  specialistId String  @db.Uuid
  dayOfWeek    Int // 0 (Sunday) - 6 (Saturday)
  startTime    String // HH:mm (24h)
  endTime      String // HH:mm (24h)
  isActive     Boolean @default(true)

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@index([specialistId, dayOfWeek])
}

model ScheduleConstraint {
  id                String  @id @default(uuid()) @db.Uuid
  specialistId      String? @db.Uuid
  serviceId         String? @db.Uuid
  serviceCategoryId String? @db.Uuid
  dayOfWeek         Int? // null = applies every day
  latestStartTime   String // HH:mm (24h)
  note              String?

  specialist      Specialist?      @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  service         Service?         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceCategory ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)

  @@index([specialistId])
}

model ScheduleException {
  id           String                @id @default(uuid()) @db.Uuid
  specialistId String                @db.Uuid
  date         DateTime              @db.Date
  type         ScheduleExceptionType
  startTime    String?
  endTime      String?
  reason       String?

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@index([specialistId, date])
}

// NOTE: a partial unique index on (specialistId, date, startTime) WHERE status != 'cancelled'
// exists in migration 20260804014323_appointment_slot_unique_active — Prisma's schema DSL
// can't express partial unique indexes, so that migration file is the source of truth for
// this constraint (prevents double-booking without blocking rebooking a cancelled slot).
model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  clientId         String            @db.Uuid
  specialistId     String            @db.Uuid
  date             DateTime          @db.Date
  startTime        String
  endTime          String
  status           AppointmentStatus @default(pending_confirmation)
  confirmationCode String            @unique
  notes            String?
  source           AppointmentSource @default(chat)
  createdAt        DateTime          @default(now())

  client       Client               @relation(fields: [clientId], references: [id])
  specialist   Specialist           @relation(fields: [specialistId], references: [id])
  services     AppointmentService[]
  photoUploads PhotoUpload[]

  @@index([specialistId, date, startTime])
  @@index([confirmationCode])
}

model AppointmentService {
  id                      String  @id @default(uuid()) @db.Uuid
  appointmentId           String  @db.Uuid
  serviceId               String  @db.Uuid
  order                   Int     @default(0)
  durationMinutesSnapshot Int
  priceSnapshot           Decimal @db.Decimal(10, 2)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@index([appointmentId])
}

model Conversation {
  id            String             @id @default(uuid()) @db.Uuid
  clientId      String?            @db.Uuid
  sessionToken  String             @unique
  status        ConversationStatus @default(active)
  createdAt     DateTime           @default(now())
  lastMessageAt DateTime           @default(now())

  client          Client?          @relation(fields: [clientId], references: [id])
  messages        Message[]
  photoUploads    PhotoUpload[]
  escalationFlags EscalationFlag[]

  @@index([sessionToken])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  role           MessageRole
  content        String
  attachmentId   String?     @db.Uuid
  toolCallMeta   Json?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachment   PhotoUpload? @relation(fields: [attachmentId], references: [id])

  @@index([conversationId])
}

model PhotoUpload {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String?      @db.Uuid
  appointmentId  String?      @db.Uuid
  clientId       String?      @db.Uuid
  filePath       String
  mimeType       String
  sizeBytes      Int
  purpose        PhotoPurpose
  createdAt      DateTime     @default(now())

  conversation Conversation? @relation(fields: [conversationId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  client       Client?       @relation(fields: [clientId], references: [id])
  messages     Message[]

  @@index([clientId])
}

model EscalationFlag {
  id                   String           @id @default(uuid()) @db.Uuid
  conversationId       String           @db.Uuid
  reason               EscalationReason
  status               EscalationStatus @default(open)
  assignedSpecialistId String?          @db.Uuid
  resolutionNotes      String?
  createdAt            DateTime         @default(now())
  resolvedAt           DateTime?

  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignedSpecialist Specialist?  @relation(fields: [assignedSpecialistId], references: [id])

  @@index([status])
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  active       Boolean   @default(true)
  lastLoginAt  DateTime?

  updatedCredentials Credential[]
}

model Credential {
  id               String   @id @default(uuid()) @db.Uuid
  key              String   @unique
  encryptedValue   String
  updatedByAdminId String?  @db.Uuid
  updatedAt        DateTime @updatedAt

  updatedByAdmin AdminUser? @relation(fields: [updatedByAdminId], references: [id])
}

model TermSynonym {
  id                  String  @id @default(uuid()) @db.Uuid
  term                String
  canonicalServiceId  String? @db.Uuid
  canonicalCategoryId String? @db.Uuid
  notes               String?

  canonicalService  Service?         @relation(fields: [canonicalServiceId], references: [id])
  canonicalCategory ServiceCategory? @relation(fields: [canonicalCategoryId], references: [id])

  @@index([term])
}

model AssistantPolicy {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ErrorLog {
  id        String   @id @default(uuid()) @db.Uuid
  source    String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
