# Local development env for the backend process (cwd = backend/).
# Copy to backend/.env and fill in values. Never commit backend/.env.
# In Docker/EasyPanel deployment, these are supplied as container env vars instead
# (see ../.env.example for the canonical Level 1/2/3 credential reference).

DATABASE_URL=postgresql://oopss:oopss@localhost:5432/oopss_nails?schema=public
JWT_SECRET=
JWT_EXPIRATION=24h
CLIENT_SESSION_SECRET=
ENCRYPTION_KEY=

NODE_ENV=development
PORT=3000

OPENAI_MODEL=gpt-4o-mini
# Bootstrap-only fallback for local dev before the admin panel's credential vault exists
# (IT-06) — the real Level-3 source of truth is that encrypted vault, not this variable.
OPENAI_API_KEY=
ADMIN_INITIAL_EMAIL=admin@oopssnails.local
ADMIN_INITIAL_PASSWORD=

CORS_ALLOWED_ORIGIN=http://localhost:5173
UPLOADS_DIR=uploads
MAX_UPLOAD_SIZE_MB=8
