# Deployment env for docker-compose (production / EasyPanel). Copy to `.env` in this same
# directory and fill in real values. Never commit `.env` to git.
#
# For local development WITHOUT Docker, use backend/.env.example instead (same variables,
# but DATABASE_URL points at whatever Postgres you're running locally).

# ── Level 1 (.env / here) — infrastructure secrets ──────────────────────────

# Postgres (used both to configure the `db` container and to build DATABASE_URL for `app` —
# see docker-compose.yml)
POSTGRES_DB=oopss_nails
POSTGRES_USER=oopss
POSTGRES_PASSWORD=

JWT_SECRET=
JWT_EXPIRATION=24h
CLIENT_SESSION_SECRET=
# Encrypts Level-3 credentials (e.g. the OpenAI API key) stored in the admin panel.
ENCRYPTION_KEY=

NODE_ENV=production
PORT=3000

# ── Level 2 (deployment config) ──────────────────────────────────────────────

OPENAI_MODEL=gpt-4o-mini
# First-run only: seeds the initial admin account. After that, manage admins via the app
# itself (login/change-password) — this variable is not read again once that account exists.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=

CORS_ALLOWED_ORIGIN=
UPLOADS_DIR=uploads
MAX_UPLOAD_SIZE_MB=8

# ── Level 3 (admin panel, encrypted) ─────────────────────────────────────────
# OPENAI_API_KEY is normally set from the admin panel (Credentials), not here. This is only
# a bootstrap fallback for first boot before any value has been configured there.
OPENAI_API_KEY=
